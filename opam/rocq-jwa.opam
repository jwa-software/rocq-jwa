opam-version: "2.0"
version: "0.1.0"
synopsis:
  "A layered Rocq library of data structures, algebra, relations and tactics"
description:
  "rocq-jwa is a general-purpose Rocq library organised in layers, each a separate theory under the logical root jwa: Core, Tactics, Algebra, Relation, Data, Assumption and Programming. Clients import a layer with From jwa Require Import <Layer>.All."
maintainer: ["Junzhe Wang <jwa.software@foobox.com>"]
authors: ["Junzhe Wang"]
license: "MIT"
tags: ["rocq" "logpath:jwa"]
homepage: "https://github.com/jwa-software/rocq-jwa"
bug-reports: "https://github.com/jwa-software/rocq-jwa/issues"
depends: [
  "dune" {>= "3.21"}
  "rocq-core" {>= "9.2"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jwa-software/rocq-jwa.git"
x-maintenance-intent: ["(latest)"]
