; A subdirectory becomes a segment of the module path: Logic/Conjunction.v
; is the module jwa.Core.Logic.Conjunction.

(include_subdirs qualified)

; Ltac2 is the one installed theory this tree depends on: the tactic
; language, loaded by Ltac.v. Each theory lists it with the rest of its
; closure. -noinit comes from the env stanza in the root dune file, not from
; here. (stdlib no) is not wanted: it unbinds Corelib, and Ltac2.Init
; requires Corelib.Init.Ltac.

(rocq.theory
 (name jwa.Core)
 (package rocq-jwa)
 (theories Ltac2))
